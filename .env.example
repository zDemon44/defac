# test = certificacion sin validez tributaria; production = comprobantes reales
SRI_ENVIRONMENT=production

# Escriba aqui una clave legitima de exactamente 49 digitos.
SRI_ACCESS_KEY=

SRI_AUTHORIZATION_WSDL_PRODUCTION=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_AUTHORIZATION_WSDL_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

SRI_REQUEST_TIMEOUT_MS=30000
SRI_OUTPUT_DIR=./output
SRI_INPUT_FILE=./ejemplo-txt-sri.txt.txt
SRI_CONCURRENCY=3
SRI_MAX_RETRIES=3
SRI_RETRY_DELAY_MS=1000
APP_PORT=3000

# MySQL local / MySQL Workbench
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=defac-base
DB_CONNECTION_LIMIT=5
